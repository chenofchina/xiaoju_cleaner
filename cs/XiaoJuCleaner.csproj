<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>XiaoJuCleaner</AssemblyName>
    <RootNamespace>XiaoJuCleaner</RootNamespace>
    <StartupObject>XiaoJuCleaner.Program</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Version>3.0.0</Version>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <Product>小橘清理大师</Product>
    <AssemblyTitle>小橘清理大师</AssemblyTitle>
    <Description>喵~ 命令行版 CCleaner</Description>
    <Company>XiaoJu</Company>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <TieredPgo>true</TieredPgo>
  </PropertyGroup>

</Project>
